{
  "name": "AI Chief of Staff — Dispatcher_TEMPLATE",
  "nodes": [
    {
      "id": "wh",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "acos-dispatch",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      }
    },
    {
      "id": "val",
      "name": "Validate & Init",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "v-mid",
              "name": "meeting_id",
              "type": "string",
              "value": "={{ ($json.body?.meeting_id ?? '').toString().trim() }}"
            },
            {
              "id": "v-act",
              "name": "action",
              "type": "string",
              "value": "={{ ($json.body?.action ?? '').toString().trim() }}"
            },
            {
              "id": "v-ten",
              "name": "tenant_id",
              "type": "string",
              "value": "{{REPLACE_ME_TENANT_ID}}"
            },
            {
              "id": "v-val",
              "name": "valid",
              "type": "boolean",
              "value": "={{ ($json.body?.meeting_id ?? '').toString().trim() !== '' && ['pro_followup','coaching_advice'].includes(($json.body?.action ?? '').toString().trim()) }}"
            },
            {
              "id": "v-err",
              "name": "error",
              "type": "string",
              "value": "={{ ($json.body?.meeting_id ?? '').toString().trim() === '' ? 'meeting_id is required' : 'action must be one of the allowed actions (siehe Array im valid-Feld dieser Node)' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ifv",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        460,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ff",
      "name": "Fetch Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        700,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 4000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.fireflies.ai/graphql",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: \"query Transcript($transcriptId: String!) { transcript(id: $transcriptId) { id title sentences { speaker_name text } } }\", variables: { transcriptId: $json.meeting_id } }) }}",
        "options": {}
      }
    },
    {
      "id": "btt",
      "name": "Build Transcript Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        940,
        -120
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b-found",
              "name": "found",
              "type": "boolean",
              "value": "={{ ($json.data?.transcript?.sentences?.length ?? 0) > 0 }}"
            },
            {
              "id": "b-tr",
              "name": "transcript",
              "type": "string",
              "value": "={{ ($json.data?.transcript?.sentences?.length ?? 0) > 0 ? (($json.data.transcript.title ? '# ' + $json.data.transcript.title + '\\n\\n' : '') + $json.data.transcript.sentences.map(s => (s.speaker_name || 'Speaker') + ': ' + (s.text || '')).join('\\n')) : '' }}"
            },
            {
              "id": "b-mid",
              "name": "meeting_id",
              "type": "string",
              "value": "={{ $('Validate & Init').item.json.meeting_id }}"
            },
            {
              "id": "b-act",
              "name": "action",
              "type": "string",
              "value": "={{ $('Validate & Init').item.json.action }}"
            },
            {
              "id": "b-ten",
              "name": "tenant_id",
              "type": "string",
              "value": "={{ $('Validate & Init').item.json.tenant_id }}"
            },
            {
              "id": "b-tt",
              "name": "transcript_title",
              "type": "string",
              "value": "={{ $json.data?.transcript?.title ?? '' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "iffound",
      "name": "Transcript Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1160,
        -120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "insrun",
      "name": "Insert Runs Row",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1400,
        -200
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "create",
        "tableId": "runs",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "tenant_id",
              "fieldValue": "={{ $json.tenant_id }}"
            },
            {
              "fieldId": "meeting_id",
              "fieldValue": "={{ $json.meeting_id }}"
            },
            {
              "fieldId": "action",
              "fieldValue": "={{ $json.action }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "running"
            },
            {
              "fieldId": "transcript",
              "fieldValue": "={{ $json.transcript }}"
            }
          ]
        }
      }
    },
    {
      "id": "prep",
      "name": "Prepare Sub-WF Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1620,
        -200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "transcript",
              "value": "={{ $json.transcript }}",
              "type": "string"
            },
            {
              "id": "p2",
              "name": "meeting_id",
              "value": "={{ $json.meeting_id }}",
              "type": "string"
            },
            {
              "id": "p3",
              "name": "run_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "p4",
              "name": "tenant_id",
              "value": "={{ $json.tenant_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sw",
      "name": "Route by Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1840,
        -200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $('Validate & Init').item.json.action }}",
                    "rightValue": "pro_followup",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pro_followup"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{ $('Validate & Init').item.json.action }}",
                    "rightValue": "coaching_advice",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "coaching_advice"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "subpf",
      "name": "Run Pro FollowUp",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2080,
        -340
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "{{REPLACE_ME_PRO_FOLLOWUP_WORKFLOW_ID}}",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "subca",
      "name": "Run Coaching Advice",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2080,
        -200
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "{{REPLACE_ME_COACHING_ADVICE_WORKFLOW_ID}}",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "updrun",
      "name": "Update Runs Row",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2360,
        -200
      ],
      "parameters": {
        "operation": "update",
        "tableId": "runs",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Prepare Sub-WF Input').item.json.run_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "success"
            },
            {
              "fieldId": "output",
              "fieldValue": "={{ $json.output }}"
            },
            {
              "fieldId": "model",
              "fieldValue": "={{ $json.model }}"
            },
            {
              "fieldId": "finished_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      }
    },
    {
      "id": "respok",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2580,
        -200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"run_id\": $json.id, \"status\": $json.status, \"action\": $json.action, \"output\": $json.output } }}",
        "options": {}
      }
    },
    {
      "id": "respinv",
      "name": "Respond Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        160
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"stage\": \"validation\", \"error\": $json.error } }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "failfetch",
      "name": "Build Failure: Fetch",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        940,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "x1",
              "name": "tenant_id",
              "value": "={{ $('Validate & Init').item.json.tenant_id }}",
              "type": "string"
            },
            {
              "id": "x2",
              "name": "meeting_id",
              "value": "={{ $('Validate & Init').item.json.meeting_id }}",
              "type": "string"
            },
            {
              "id": "x3",
              "name": "action",
              "value": "={{ $('Validate & Init').item.json.action }}",
              "type": "string"
            },
            {
              "id": "x4",
              "name": "error",
              "value": "=Fireflies transcript fetch failed for meeting_id {{ $('Validate & Init').item.json.meeting_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "failnf",
      "name": "Build Failure: Not Found",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1400,
        60
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "y1",
              "name": "tenant_id",
              "value": "={{ $json.tenant_id }}",
              "type": "string"
            },
            {
              "id": "y2",
              "name": "meeting_id",
              "value": "={{ $json.meeting_id }}",
              "type": "string"
            },
            {
              "id": "y3",
              "name": "action",
              "value": "={{ $json.action }}",
              "type": "string"
            },
            {
              "id": "y4",
              "name": "error",
              "value": "=No Fireflies transcript found for meeting_id {{ $json.meeting_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "insfail",
      "name": "Insert Failed Run",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1840,
        140
      ],
      "parameters": {
        "operation": "create",
        "tableId": "runs",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "tenant_id",
              "fieldValue": "={{ $json.tenant_id }}"
            },
            {
              "fieldId": "meeting_id",
              "fieldValue": "={{ $json.meeting_id }}"
            },
            {
              "fieldId": "action",
              "fieldValue": "={{ $json.action }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "failed"
            },
            {
              "fieldId": "error",
              "fieldValue": "={{ $json.error }}"
            }
          ]
        }
      }
    },
    {
      "id": "markfail",
      "name": "Mark Run Failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2360,
        60
      ],
      "parameters": {
        "operation": "update",
        "tableId": "runs",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Prepare Sub-WF Input').item.json.run_id }}"
